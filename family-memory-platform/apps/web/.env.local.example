# Copy to apps/web/.env.local before `pnpm dev` (from repo root or apps/web).
#
# Ubuntu/WSL (recommended local setup):
#   API on localhost:4000 → use the value below as-is.
#
# Windows host-run with a non-default API port (e.g. API_PORT=4002):
#   NEXT_PUBLIC_API_URL=http://localhost:4002/api/v1
#
# Must match the running API base URL including /api/v1 suffix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Map tiles: auto (probe TileServer, else vintage OSM) | remote | tileserver-gl
# NEXT_PUBLIC_MAP_TILE_SOURCE=auto
# NEXT_PUBLIC_TILESERVER_URL=http://localhost:8080
# NEXT_PUBLIC_TILESERVER_STYLE=/styles/basic/style.json
