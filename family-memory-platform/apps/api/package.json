{
  "name": "@family/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS REST API — auth, genealogy entities, media, search, GEDCOM",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');for(const p of['dist','tsconfig.build.tsbuildinfo']){try{fs.rmSync(p,{recursive:true,force:true})}catch{}}\"",
    "build": "pnpm run clean && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "dev": "pnpm run build && nest start --watch",
    "start": "node ../../scripts/api-start.mjs",
    "start:prod": "node ../../scripts/api-start.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"api: tests not configured yet\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@family/genealogy-core": "workspace:*",
    "@family/matching-core": "workspace:*",
    "@family/map-engine": "workspace:*",
    "@family/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "graphql": "^16.10.0",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "archiver": "^7.0.1",
    "bullmq": "^5.34.5",
    "otplib": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "5.10.1",
    "minio": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "puppeteer-core": "^24.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  }
}
