// Family Memory Platform — PostgreSQL schema (MVP entities)
// Run: pnpm db:generate && pnpm db:migrate

generator client {
  provider      = "prisma-client-js"
  // WSL: native = debian. Windows: native = windows. Do not add explicit "windows" here — generate from WSL would try to rewrite .dll on /mnt/d/ and hit EPERM.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth & admin ---

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  auditLogs AuditLog[]
  questProgress      QuestProgress[]
  userAchievements   UserAchievement[]
  gamificationEvents GamificationEvent[]
  photoFaceTagsCreated PhotoFaceTag[] @relation("PhotoFaceTagCreator")
  mediaComments        MediaComment[]

  communityGroupsOwned       CommunityGroup[]       @relation("CommunityGroupOwner")
  forumThreadsAuthored       ForumThread[]          @relation("ForumThreadAuthor")
  forumPostsAuthored         ForumPost[]            @relation("ForumPostAuthor")
  researchRequestsAuthored   ResearchRequest[]      @relation("ResearchRequestAuthor")
  moderationReportsFiled     ModerationReport[]     @relation("ModerationReportReporter")
  moderationActionsPerformed ModerationAction[]     @relation("ModerationActionModerator")
  reputationEvents           CommunityReputationEvent[] @relation("ReputationEventUser")
  forumHelpfulVotes          ForumPostHelpfulVote[]
  researcherPublicProfile    ResearcherPublicProfile?
  communityUserStrike        CommunityUserStrike?
  matchProfile               MatchProfile?
  workspaceMemberships       WorkspaceMember[]
  treeMatchRunsRequested     TreeMatchRun[]         @relation("TreeMatchRunRequester")
  treeMatchCandidatesReviewed TreeMatchCandidate[]  @relation("TreeMatchCandidateReviewer")
  familyStoriesCreated       FamilyStory[]          @relation("FamilyStoryCreator")
  aiStoryDrafts              AiStoryDraft[]
  workspaceInvitesSent       WorkspaceInvite[]    @relation("WorkspaceInviteInviter")
  privacyRequests            PrivacyRequest[]
  userConsents               UserConsent[]
  publicSharesCreated        PublicShare[]      @relation("PublicShareCreator")
  accessLogs                 AccessLog[]

  @@index([role])
  @@index([deletedAt])
}

enum UserRole {
  VIEWER
  EDITOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  PARTNER
  ADOPTIVE_PARENT
  ADOPTIVE_CHILD
  UNKNOWN
}

enum EventType {
  BIRTH
  DEATH
  MARRIAGE
  DIVORCE
  BURIAL
  RESIDENCE
  MIGRATION
  EDUCATION
  MILITARY
  WORK
  OCCUPATION
  IMMIGRATION
  CUSTOM
}

enum PrivacyLevel {
  PUBLIC
  FAMILY
  PRIVATE
}

enum MediaOwnerType {
  PERSON
  FAMILY
  EVENT
  DOCUMENT
  SOURCE
}

enum StorageProvider {
  MINIO
}

enum DocumentType {
  BIRTH_CERTIFICATE
  DEATH_CERTIFICATE
  MARRIAGE_CERTIFICATE
  PHOTO
  ARCHIVE_RECORD
  PASSPORT
  MILITARY_RECORD
  OTHER
}

// --- Genealogy core ---

model Person {
  id           String       @id @default(cuid())
  givenName    String
  patronymic   String?
  familyName   String?
  gender       Gender?      @default(UNKNOWN)
  birthDate    DateTime?
  deathDate    DateTime?
  isLiving     Boolean      @default(true)
  privacyLevel PrivacyLevel @default(PRIVATE)
  biography    String?      @db.Text
  avatarMediaId String?     @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  avatarMedia       Media?  @relation("PersonAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  relationshipsFrom Relationship[] @relation("fromPerson")
  relationshipsTo   Relationship[] @relation("toPerson")
  familyMembers     FamilyMember[]
  events            Event[]
  media             Media[]
  documents         Document[]
  timelineItems     TimelineItem[]
  citations         Citation[]
  photoFaceTags     PhotoFaceTag[]
  nameAliases       PersonNameAlias[]
  matchCandidatesAsSource TreeMatchCandidate[] @relation("MatchSourcePerson")
  matchCandidatesAsTarget TreeMatchCandidate[] @relation("MatchTargetPerson")

  @@index([familyName, givenName])
  @@index([birthDate])
  @@index([deathDate])
  @@index([isLiving])
  @@index([privacyLevel])
  @@index([deletedAt])
}

model Family {
  id                 String       @id @default(cuid())
  workspaceId        String?
  name               String?
  notes              String?      @db.Text
  hideLivingPersons  Boolean      @default(true)
  treePrivacyLevel   PrivacyLevel @default(PRIVATE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  members   FamilyMember[]
  events    Event[]
  matchRuns TreeMatchRun[]

  @@index([workspaceId])
  @@index([name])
  @@index([deletedAt])
}

model FamilyMember {
  id        String           @id @default(cuid())
  familyId  String
  personId  String
  role      FamilyMemberRole @default(CHILD)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([familyId, personId])
  @@index([personId, role])
  @@index([deletedAt])
}

enum FamilyMemberRole {
  HUSBAND
  WIFE
  PARTNER
  CHILD
}

model Relationship {
  id           String           @id @default(cuid())
  fromPersonId String
  toPersonId   String
  type         RelationshipType @default(PARENT)
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  confidence   Float?           @default(1.0)
  sourceId     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  fromPerson Person  @relation("fromPerson", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson   Person  @relation("toPerson", fields: [toPersonId], references: [id], onDelete: Cascade)
  source     Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([fromPersonId])
  @@index([toPersonId])
  @@index([type])
  @@index([sourceId])
  @@index([deletedAt])
}

model Event {
  id          String    @id @default(cuid())
  type        EventType @default(CUSTOM)
  date        DateTime?
  dateEnd     DateTime?
  description String?   @db.Text
  personId    String?
  familyId    String?
  placeId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  place  Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  timelineItems TimelineItem[]

  @@index([personId, date])
  @@index([familyId, date])
  @@index([placeId])
  @@index([type])
  @@index([deletedAt])
}

model Place {
  id        String    @id @default(cuid())
  name      String
  latitude  Float?
  longitude Float?
  country   String?
  region    String?
  city      String?
  geoCountryId String?
  geoRegionId  String?
  geoCityId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  geoCountry Country? @relation(fields: [geoCountryId], references: [id], onDelete: SetNull)
  geoRegion  Region?  @relation(fields: [geoRegionId], references: [id], onDelete: SetNull)
  geoCity    City?    @relation(fields: [geoCityId], references: [id], onDelete: SetNull)
  events     Event[]

  @@index([country, region, city])
  @@index([geoCountryId])
  @@index([geoRegionId])
  @@index([geoCityId])
  @@index([name])
  @@index([deletedAt])
}

// --- Historical geography (local reference data) ---

model Country {
  id             String   @id @default(cuid())
  name           String
  historicalName String?
  iso2           String?
  iso3           String?
  periodFrom     Int?
  periodTo       Int?
  latitude       Float?
  longitude      Float?
  geonamesId     Int?     @unique
  wikidataId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  regions Region[]
  cities  City[]
  places  Place[]

  @@index([periodFrom, periodTo])
  @@index([iso2])
  @@index([name])
}

model Region {
  id         String   @id @default(cuid())
  countryId  String
  name       String
  admin1Key  String?
  periodFrom Int?
  periodTo   Int?
  geonamesId Int?     @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  City[]
  places  Place[]

  @@index([countryId])
  @@index([periodFrom, periodTo])
  @@index([name])
  @@index([admin1Key])
}

model City {
  id             String   @id @default(cuid())
  countryId      String
  regionId       String?
  name           String
  historicalName String?
  latitude       Float?
  longitude      Float?
  population     Int?
  timezone       String?
  periodFrom     Int?
  periodTo       Int?
  geonamesId     Int?     @unique
  wikidataId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  country Country              @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region  Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  aliases HistoricalPlaceAlias[]
  places  Place[]

  @@index([countryId])
  @@index([regionId])
  @@index([periodFrom, periodTo])
  @@index([name])
}

model HistoricalPlaceAlias {
  id       String   @id @default(cuid())
  cityId   String
  oldName  String
  fromYear Int?
  toYear   Int?
  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([oldName])
}

/// Localized display names (GeoNames alternateNamesV2: en, de, fr, es, ru).
enum GeoEntityType {
  COUNTRY
  REGION
  CITY
}

model GeographicName {
  id          String        @id @default(cuid())
  entityType  GeoEntityType
  entityId    String
  locale      String
  name        String
  isPreferred Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([entityType, entityId])
  @@index([locale, name])
  @@index([entityType, locale, name])
}

// --- Media & documents ---

model Media {
  id              String          @id @default(cuid())
  personId        String?
  privacyLevel    PrivacyLevel    @default(PRIVATE)
  title           String?
  mimeType        String
  storageProvider StorageProvider @default(MINIO)
  storageKey      String // MinIO object key
  bucket          String
  sizeBytes       Int?
  takenAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  person        Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  personAvatar  Person?     @relation("PersonAvatar")
  documents     Document[]
  links         MediaLink[]
  faceTags      PhotoFaceTag[]
  insight       PhotoInsight?
  comments      MediaComment[]
  analysisJobs  PhotoAnalysisJob[]

  @@unique([bucket, storageKey])
  @@index([personId])
  @@index([privacyLevel])
  @@index([mimeType])
  @@index([takenAt])
  @@index([deletedAt])
}

model MediaLink {
  id        String         @id @default(cuid())
  mediaId   String
  ownerType MediaOwnerType
  ownerId   String
  createdAt DateTime       @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, ownerType, ownerId])
  @@index([ownerType, ownerId])
  @@index([mediaId])
}

enum FaceTagSource {
  MANUAL
  AI
}

enum PhotoAnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model PhotoFaceTag {
  id         String        @id @default(cuid())
  mediaId    String
  personId   String?
  x          Float
  y          Float
  width      Float
  height     Float
  confidence Float?
  label      String?
  note       String?       @db.Text
  source     FaceTagSource @default(MANUAL)
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  creator User?   @relation("PhotoFaceTagCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([personId])
  @@index([createdBy])
}

model PhotoInsight {
  id                    String   @id @default(cuid())
  mediaId               String   @unique
  estimatedYearFrom     Int?
  estimatedYearTo       Int?
  detectedObjects       Json?
  detectedClothingStyle String?
  aiDescription         String?  @db.Text
  uncertaintyNotes      String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([estimatedYearFrom, estimatedYearTo])
}

model MediaComment {
  id        String   @id @default(cuid())
  mediaId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media  Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([authorId])
}

model PhotoAnalysisJob {
  id          String              @id @default(cuid())
  mediaId     String
  status      PhotoAnalysisStatus @default(QUEUED)
  error       String?             @db.Text
  requestedBy String?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([status])
}

model Document {
  id           String       @id @default(cuid())
  personId     String?
  mediaId      String?
  sourceId     String?
  privacyLevel PrivacyLevel @default(FAMILY)
  title        String
  documentType DocumentType @default(OTHER)
  mimeType     String
  storageKey   String
  bucket       String
  description  String?      @db.Text
  ocrText      String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  media  Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  forumThreads ForumThread[]

  @@index([personId])
  @@index([privacyLevel])
  @@index([mediaId])
  @@index([sourceId])
  @@index([documentType])
  @@index([deletedAt])
}

// --- Sources & citations (genealogical proof standard) ---

model Source {
  id          String    @id @default(cuid())
  title       String
  author      String?
  publication String?
  repository  String?
  url         String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  citations     Citation[]
  documents     Document[]
  relationships Relationship[]

  @@index([title])
  @@index([deletedAt])
}

model Citation {
  id        String    @id @default(cuid())
  sourceId  String
  personId  String?
  page      String?
  detail    String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  source Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([personId])
  @@index([deletedAt])
}

// --- Timeline & audit ---

model TimelineItem {
  id          String    @id @default(cuid())
  personId    String
  eventId     String?
  title       String
  description String?   @db.Text
  sortDate    DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([personId, sortDate])
  @@index([eventId])
  @@index([deletedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  payload     Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

// --- Gamification / Family Quest ---

enum QuestStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

model QuestProgress {
  id          String      @id @default(cuid())
  userId      String
  questId     String
  progress    Int         @default(0)
  target      Int
  status      QuestStatus @default(AVAILABLE)
  weekStart   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, weekStart])
  @@index([userId])
  @@index([questId])
  @@index([status])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model GamificationEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ResearchScoreSnapshot {
  id         String   @id @default(cuid())
  score      Int
  breakdown  Json
  treeRootId String?
  computedAt DateTime @default(now())

  @@index([computedAt])
}

// --- Community / forum (PROMPT 8) — privacy + moderation first-class ---

enum CommunityGroupType {
  SURNAME
  REGION
  COUNTRY
  PERIOD
  TOPIC
}

enum CommunityGroupVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum ForumThreadStatus {
  OPEN
  LOCKED
  ARCHIVED
}

enum ForumContentStatus {
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  FLAGGED
  DELETED
}

enum ResearchRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ModerationReportCategory {
  SPAM
  HARASSMENT
  PERSONAL_DATA_LIVING
  MISINFORMATION
  OFF_TOPIC
  COPYRIGHT
  OTHER
}

enum ModerationReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARN
  HIDE_CONTENT
  SOFT_DELETE
  RESTORE
  BAN_USER_TEMP
  BAN_USER_PERM
}

enum CommunityReputationEventType {
  HELPFUL_POST
  THREAD_START
  REPLY
  EXPERT_ANSWER_ACCEPTED
  MODERATION_PENALTY
  REPORT_UPHELD_AGAINST
}

model CommunityGroup {
  id          String                   @id @default(cuid())
  type        CommunityGroupType
  title       String
  description String?                  @db.Text
  visibility  CommunityGroupVisibility @default(PUBLIC)
  ownerId     String
  /// Optional structured filters (surname slug, ISO region, year range)
  slug        String?
  regionLabel String?
  countryCode String?
  periodFrom  Int?
  periodTo    Int?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?

  owner            User                         @relation("CommunityGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  threads          ForumThread[]
  reputationEvents CommunityReputationEvent[]

  @@index([type])
  @@index([ownerId])
  @@index([slug])
  @@index([deletedAt])
}

model ForumThread {
  id          String             @id @default(cuid())
  groupId     String
  authorId    String
  title       String
  tags        String[]           @default([])
  status      ForumThreadStatus  @default(OPEN)
  /// Link forum topic to a platform document (discuss archives)
  documentId  String?
  contentStatus ForumContentStatus @default(PUBLISHED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   User           @relation("ForumThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  document Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  posts    ForumPost[]
  helpfulVotes ForumPostHelpfulVote[]

  @@index([groupId])
  @@index([authorId])
  @@index([documentId])
  @@index([contentStatus])
  @@index([deletedAt])
}

model ForumPost {
  id            String             @id @default(cuid())
  threadId      String
  authorId      String
  content       String             @db.Text
  /// JSON: [{ "mediaId"?: string, "documentId"?: string }]
  attachments   Json?
  /// G1: if true, public listing requires hasConsentForPublicLivingData
  referencesLivingPersonData Boolean @default(false)
  hasConsentForPublicLivingData Boolean @default(false)
  contentStatus ForumContentStatus @default(PUBLISHED)
  isExpertAnswer Boolean           @default(false)
  helpfulCount  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  helpfulVotes ForumPostHelpfulVote[]

  @@index([threadId])
  @@index([authorId])
  @@index([contentStatus])
  @@index([deletedAt])
}

model ForumPostHelpfulVote {
  id        String   @id @default(cuid())
  threadId  String
  postId    String
  voterId   String
  createdAt DateTime @default(now())

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post   ForumPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  voter  User        @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([postId, voterId])
  @@index([threadId])
  @@index([voterId])
}

model ResearchRequest {
  id          String                 @id @default(cuid())
  authorId    String
  surname     String?
  region      String?
  period      String?
  description String                 @db.Text
  status      ResearchRequestStatus  @default(OPEN)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?

  author User @relation("ResearchRequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([status])
  @@index([surname])
  @@index([deletedAt])
}

model ResearcherPublicProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?  @db.Text
  specialties String[] @default([])
  locale      String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityReputationEvent {
  id              String                     @id @default(cuid())
  userId          String
  groupId         String
  type            CommunityReputationEventType
  baseWeight      Float
  decayMultiplier Float                      @default(1.0)
  /// Snapshot after this event (optional, for audit)
  note            String?
  relatedPostId   String?
  relatedThreadId String?
  createdAt       DateTime                   @default(now())

  user  User           @relation("ReputationEventUser", fields: [userId], references: [id], onDelete: Cascade)
  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, groupId])
  @@index([groupId, createdAt])
  @@index([type])
}

model CommunityUserStrike {
  id         String   @id @default(cuid())
  userId     String   @unique
  strikeCount Int     @default(0)
  lastStrikeAt DateTime?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModerationReport {
  id          String                   @id @default(cuid())
  reporterId  String
  targetType  String // e.g. FORUM_POST, FORUM_THREAD, RESEARCH_REQUEST
  targetId    String
  category    ModerationReportCategory
  details     String?                  @db.Text
  status      ModerationReportStatus   @default(OPEN)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  reporter User @relation("ModerationReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

model ModerationAction {
  id           String               @id @default(cuid())
  moderatorId  String
  targetType   String
  targetId     String
  actionType   ModerationActionType
  reason       String?              @db.Text
  metadata     Json?
  createdAt    DateTime             @default(now())

  moderator User @relation("ModerationActionModerator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([moderatorId])
  @@index([createdAt])
}

// --- Multi-tenant workspace (PROMPT 9) ---

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]
}

enum WorkspaceMemberRole {
  OWNER
  EDITOR
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  families      Family[]
  matchRuns     TreeMatchRun[]
  familyStories FamilyStory[]
  aiStoryDrafts AiStoryDraft[]
  billingAccount BillingAccount?
  subscription   WorkspaceSubscription?
  featureFlags   FeatureFlag[]
  usageLimits    UsageLimit[]
  invites        WorkspaceInvite[]
  auditLogs       AuditLog[]
  privacyRequests PrivacyRequest[]
  publicShares    PublicShare[]
  accessLogs      AccessLog[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(EDITOR)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Global tree matching opt-in (user-level gate for cross-tree discovery).
model MatchProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  isOptedIn  Boolean   @default(false)
  optedInAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonNameAlias {
  id         String   @id @default(cuid())
  personId   String
  givenName  String?
  patronymic String?
  familyName String?
  label      String?
  createdAt  DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([familyName, givenName])
}

enum TreeMatchRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum TreeMatchCandidateStatus {
  NEW
  ACCEPTED
  REJECTED
  NEEDS_REVIEW
}

model TreeMatchRun {
  id           String             @id @default(cuid())
  familyId     String
  workspaceId  String
  requestedBy  String?
  status       TreeMatchRunStatus @default(QUEUED)
  error        String?            @db.Text
  stats        Json?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester   User?       @relation("TreeMatchRunRequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  candidates  TreeMatchCandidate[]

  @@index([familyId, createdAt])
  @@index([workspaceId])
  @@index([status])
}

model TreeMatchCandidate {
  id                String                   @id @default(cuid())
  runId             String?
  sourcePersonId    String
  targetPersonId    String
  sourceWorkspaceId String
  targetWorkspaceId String
  score             Float
  reasons           Json
  status            TreeMatchCandidateStatus @default(NEW)
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  run             TreeMatchRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  sourcePerson    Person        @relation("MatchSourcePerson", fields: [sourcePersonId], references: [id], onDelete: Cascade)
  targetPerson    Person        @relation("MatchTargetPerson", fields: [targetPersonId], references: [id], onDelete: Cascade)
  reviewer        User?         @relation("TreeMatchCandidateReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([sourcePersonId, targetPersonId])
  @@index([sourcePersonId, status])
  @@index([targetPersonId])
  @@index([runId])
  @@index([status, score])
}

// --- Public Family Stories (PROMPT 10) ---

enum StoryVisibility {
  PUBLIC
  PRIVATE
  FAMILY_ONLY
  LINK_ONLY
}

enum FamilyStoryTemplate {
  CLASSIC
  HERITAGE
  JOURNEY
  GALLERY
}

enum FamilyStoryScopeType {
  PERSON
  FAMILY_BRANCH
}

// --- AI Storytelling (PROMPT 11) ---

enum AiStoryType {
  PERSON
  FAMILY
  MIGRATION
  DOCUMENT_SUMMARY
  TIMELINE_NARRATIVE
  ERA_CONTEXT
}

enum AiStoryMode {
  DRY_BIOGRAPHY
  ARTISTIC
  ARCHIVE
  FAMILY_BOOK
}

enum AiStoryDraftStatus {
  DRAFT
  PUBLISHED
}

model FamilyStory {
  id                   String               @id @default(cuid())
  workspaceId          String?
  createdById          String
  title                String
  slug                 String?              @unique
  template             FamilyStoryTemplate  @default(CLASSIC)
  visibility           StoryVisibility      @default(LINK_ONLY)
  publicTokenHash      String               @unique
  narrativeText        String?              @db.Text
  narrativeGeneratedAt DateTime?
  hideLivingPersons    Boolean              @default(true)
  scopeType            FamilyStoryScopeType
  scopePersonId        String?
  scopeFamilyId        String?
  configJson           Json
  coverMediaId         String?
  ogDescription        String?              @db.VarChar(500)
  viewCount            Int                  @default(0)
  lastViewedAt         DateTime?
  tokenRevokedAt       DateTime?
  publishedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdBy User       @relation("FamilyStoryCreator", fields: [createdById], references: [id], onDelete: Cascade)
  views     FamilyStoryView[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([visibility])
  @@index([deletedAt])
}

model FamilyStoryView {
  id           String   @id @default(cuid())
  storyId      String
  viewedAt     DateTime @default(now())
  viewerIpHash String?
  userAgent    String?  @db.VarChar(512)

  story FamilyStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, viewedAt])
}

model AiStoryDraft {
  id               String            @id @default(cuid())
  workspaceId       String?
  createdById       String
  storyType         AiStoryType
  mode              AiStoryMode
  status            AiStoryDraftStatus @default(DRAFT)
  language          String            @default("ru")
  title             String?
  scopePersonId     String?
  scopeFamilyId     String?
  scopeDocumentId   String?
  narrativeText     String?           @db.Text
  payloadJson       Json
  uncertaintyScore  Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
  @@index([storyType])
  @@index([mode])
  @@index([status])
  @@index([scopePersonId])
  @@index([scopeDocumentId])
  @@index([deletedAt])
}

// --- Commercial / SaaS foundation (PROMPT 12) — billing-ready, no payment gateway ---

enum SubscriptionPlanCode {
  FREE
  FAMILY
  RESEARCHER
  PROFESSIONAL
  ON_PREM
}

enum BillingAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WorkspaceSubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
  PAST_DUE
}

enum FeatureFlagScope {
  GLOBAL
  WORKSPACE
  USER
}

enum UsageMetric {
  FAMILIES
  PERSONS
  MEDIA_BYTES
  AI_CREDITS
  GEDCOM_EXPORTS
  REPORT_EXPORTS
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PrivacyRequestType {
  EXPORT
  DELETE
  CONSENT_UPDATE
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Catalog of subscription tiers (seeded; no Stripe IDs yet).
model SubscriptionPlan {
  id           String               @id @default(cuid())
  code         SubscriptionPlanCode @unique
  name         String
  description  String?              @db.Text
  entitlements Json
  isActive     Boolean              @default(true)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  subscriptions WorkspaceSubscription[]
}

/// Billing identity per workspace — ready for external customer id later.
model BillingAccount {
  id                 String               @id @default(cuid())
  workspaceId        String               @unique
  status             BillingAccountStatus @default(ACTIVE)
  billingEmail       String?
  externalCustomerId String?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSubscription {
  id          String                      @id @default(cuid())
  workspaceId String                      @unique
  planId      String
  status      WorkspaceSubscriptionStatus @default(ACTIVE)
  periodStart DateTime                    @default(now())
  periodEnd   DateTime?
  trialEndsAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
}

model FeatureFlag {
  id          String           @id @default(cuid())
  key         String
  scope       FeatureFlagScope @default(WORKSPACE)
  workspaceId String?
  userId      String?
  enabled     Boolean          @default(true)
  value       Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([key, scope, workspaceId, userId])
  @@index([workspaceId])
  @@index([key])
}

model UsageLimit {
  id          String      @id @default(cuid())
  workspaceId String
  metric      UsageMetric
  used        BigInt      @default(0)
  limitValue  BigInt
  periodStart DateTime    @default(now())
  periodEnd   DateTime?
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodStart])
  @@index([workspaceId])
}

model WorkspaceInvite {
  id          String                @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceMemberRole   @default(EDITOR)
  tokenHash   String                @unique
  status      WorkspaceInviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
}

model PrivacyRequest {
  id          String               @id @default(cuid())
  userId      String
  workspaceId String?
  type        PrivacyRequestType
  status      PrivacyRequestStatus @default(PENDING)
  payload     Json?
  resultUrl   String?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([workspaceId])
  @@index([status])
}

// --- PROMPT 13: Privacy & Security Center ---

enum PublicShareResourceType {
  PERSON
  FAMILY_TREE
  MEDIA_BUNDLE
  FAMILY_STORY
}

enum AccessLogAction {
  VIEW
  EXPORT
  AI_INFERENCE
  PUBLIC_LINK_OPEN
}

enum UserConsentKey {
  GDPR_DATA_PROCESSING
  GLOBAL_MATCHING
  AI_LOCAL_PROCESSING
}

model PublicShare {
  id                String                  @id @default(cuid())
  workspaceId       String?
  createdById       String
  resourceType      PublicShareResourceType
  resourceId        String
  familyStoryId     String?
  label             String?
  publicTokenHash   String                  @unique
  hideLivingPersons Boolean                 @default(true)
  tokenRevokedAt    DateTime?
  expiresAt         DateTime?
  viewCount         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdBy User        @relation("PublicShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  accessLogs AccessLog[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([resourceType, resourceId])
}

model AccessLog {
  id            String          @id @default(cuid())
  workspaceId   String?
  userId        String?
  publicShareId String?
  resourceType  String
  resourceId    String?
  action        AccessLogAction
  ipHash        String?
  userAgent     String?         @db.VarChar(512)
  metadata      Json?
  createdAt     DateTime        @default(now())

  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  publicShare PublicShare? @relation(fields: [publicShareId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([publicShareId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model UserConsent {
  id        String         @id @default(cuid())
  userId    String
  consentKey UserConsentKey
  granted   Boolean        @default(false)
  version   String         @default("1")
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentKey])
  @@index([userId])
}
