model FaceEmbedding {
  id           String              @id @default(cuid())
  workspaceId  String
  faceTagId    String              @unique
  vectorJson   Json
  model        String              @default("mvp-hash-v1")
  status       FaceEmbeddingStatus @default(PENDING)
  qualityScore Float?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  faceTag   PhotoFaceTag       @relation(fields: [faceTagId], references: [id], onDelete: Cascade)
  clusterMember FaceClusterMember?

  @@index([workspaceId, status])
}

model FaceCluster {
  id                        String            @id @default(cuid())
  workspaceId               String
  status                    FaceClusterStatus @default(UNREVIEWED)
  personId                  String?
  label                     String?
  memberCount               Int               @default(0)
  representativeEmbeddingId String?
  lastRebuildAt             DateTime?
  assignedById              String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  members   FaceClusterMember[]

  @@index([workspaceId, status, memberCount])
}

model FaceClusterMember {
  id                 String  @id @default(cuid())
  clusterId          String
  embeddingId        String  @unique
  distanceToCentroid Float   @default(0)
  isRepresentative   Boolean @default(false)

  cluster   FaceCluster   @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  embedding FaceEmbedding @relation(fields: [embeddingId], references: [id], onDelete: Cascade)

  @@index([clusterId])
}

model MemoryStory {
  id                String            @id @default(cuid())
  workspaceId       String
  title             String
  description       String?           @db.Text
  mediaId           String?
  subjectPersonId   String
  narratorPersonId  String?
  language          String            @default("ru")
  status            MemoryStoryStatus @default(DRAFT)
  summary           String?           @db.Text
  mentionedPersonIds Json?
  recordedAt        DateTime?
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  media       Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  subjectPerson  Person @relation("MemoryStorySubject", fields: [subjectPersonId], references: [id], onDelete: Cascade)
  narratorPerson Person? @relation("MemoryStoryNarrator", fields: [narratorPersonId], references: [id], onDelete: SetNull)
  creator     User      @relation("MemoryStoryCreator", fields: [createdById], references: [id], onDelete: Cascade)
  transcriptJobs MediaTranscriptJob[]

  @@index([workspaceId, status])
  @@index([subjectPersonId])
  @@index([deletedAt])
}

model MediaTranscript {
  id          String   @id @default(cuid())
  mediaId     String   @unique
  text        String   @db.Text
  segments    Json?
  language    String   @default("ru")
  confidence  Float?
  editedAt    DateTime?
  editedById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model MediaTranscriptJob {
  id            String                @id @default(cuid())
  mediaId       String
  memoryStoryId String?
  status        MediaTranscriptStatus @default(QUEUED)
  error         String?               @db.Text
  requestedBy   String?
  language      String                @default("ru")
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  memoryStory MemoryStory? @relation(fields: [memoryStoryId], references: [id], onDelete: SetNull)

  @@index([mediaId, createdAt])
  @@index([status])
}

model SocialArchiveImport {
  id            String                    @id @default(cuid())
  workspaceId   String
  provider      SocialArchiveProvider     @default(UNKNOWN)
  status        SocialArchiveImportStatus @default(UPLOADED)
  fileName      String
  stagingKey    String
  sizeBytes     Int
  parsedCount   Int                       @default(0)
  selectedCount Int                       @default(0)
  importedCount Int                       @default(0)
  error         String?                   @db.Text
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User                 @relation("SocialArchiveImportCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items     SocialArchiveItem[]

  @@index([workspaceId, status, createdAt])
  @@index([expiresAt])
}

model SocialArchiveItem {
  id                String                  @id @default(cuid())
  workspaceId       String
  importId          String
  externalId        String
  kind              SocialArchiveItemKind   @default(PHOTO)
  title             String?
  caption           String?                 @db.Text
  takenAt           DateTime?
  stagingMediaKey   String?
  privacyFlags      Json                    @default("[]")
  status            SocialArchiveItemStatus @default(STAGED)
  selected          Boolean                 @default(false)
  committedMediaId  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  import    SocialArchiveImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, externalId])
  @@index([importId, status])
  @@index([workspaceId])
}

// --- BLOCK 5: Webhooks API ---

enum WebhookEventType {
  PERSON_CREATED
  MEDIA_UPLOADED
  STORY_PUBLISHED
  MATCH_FOUND
  MESSAGE_CREATED
  PING
}

enum WebhookEventStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

model WebhookEndpoint {
  id                  String                @id @default(cuid())
  workspaceId         String
  url                 String
  description         String?
  secretHash          String
  secretPrefix        String
  secretEnc           String
  subscribedEvents    WebhookEventType[]
  status              WebhookEndpointStatus @default(ACTIVE)
  createdById         String
  disabledAt          DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation("WebhookEndpointCreator", fields: [createdById], references: [id], onDelete: Cascade)
  events    WebhookEvent[]

  @@index([workspaceId, status])
}

model WebhookEvent {
  id             String             @id @default(cuid())
  workspaceId    String
  endpointId     String
  eventType      WebhookEventType
  status         WebhookEventStatus @default(PENDING)
  payload        Json
  entityType     String?
  entityId       String?
  attemptCount   Int                @default(0)
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  lastError      String?            @db.Text
  idempotencyKey String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts  WebhookDeliveryAttempt[]

  @@index([endpointId, createdAt])
  @@index([workspaceId, status, nextRetryAt])
}

model WebhookDeliveryAttempt {
  id                  String   @id @default(cuid())
  eventId             String
  attemptNumber       Int
  httpStatus          Int?
  responseBodySnippet String?  @db.Text
  durationMs          Int?
  errorMessage        String?  @db.Text
  createdAt           DateTime @default(now())

  event WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, attemptNumber])
}

