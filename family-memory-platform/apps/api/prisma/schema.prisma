  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("PdfExportRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([requestedById])
}

enum DnaProvider {
  TWENTY_THREE_AND_ME
  ANCESTRY
  UNKNOWN
}

enum DnaImportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model DnaProfile {
  id          String      @id @default(cuid())
  workspaceId String
  userId      String
  provider    DnaProvider @default(UNKNOWN)
  snpCount    Int         @default(0)
  fileKey     String?
  fileName    String?
  importedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model DnaImportJob {
  id          String             @id @default(cuid())
  workspaceId String
  userId      String
  status      DnaImportJobStatus @default(QUEUED)
  fileKey     String
  fileName    String
  provider    DnaProvider?
  snpCount    Int?
  error       String?            @db.Text
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([userId])
}

model Cemetery {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  address     String?
  latitude    Float?
  longitude   Float?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  burialSites BurialSite[]

  @@index([workspaceId])
}

model BurialSite {
  id          String    @id @default(cuid())
  workspaceId String
  cemeteryId  String
  personId    String?
  plotLabel   String?
  latitude    Float?
  longitude   Float?
  burialDate  DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cemetery  Cemetery  @relation(fields: [cemeteryId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  memorials Memorial[]
  photogrammetryJobs BurialPhotogrammetryJob[]

  @@index([workspaceId])
  @@index([cemeteryId])
  @@index([personId])
}

model Memorial {
  id           String   @id @default(cuid())
  workspaceId  String
  burialSiteId String
  title        String
  inscription  String?  @db.Text
  photoMediaId String?
  shareToken   String?  @unique
  shareEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  burialSite BurialSite @relation(fields: [burialSiteId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([burialSiteId])
}

enum DnaMatchStatus {
  SUGGESTED
  DISMISSED
}

model DnaMatchCandidate {
  id             String         @id @default(cuid())
  workspaceId    String
  profileUserId  String
  displayLabel   String
  sharedSegments Int            @default(0)
  totalCm        Float          @default(0)
  confidence     Float          @default(0)
  status         DnaMatchStatus @default(SUGGESTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, profileUserId])
}

enum BurialPhotogrammetryStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model BurialPhotogrammetryJob {
  id            String                     @id @default(cuid())
  workspaceId   String
  burialSiteId  String
  sourceMediaId String?
  status        BurialPhotogrammetryStatus @default(QUEUED)
  sceneJson     Json?
  error         String?                    @db.Text
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  completedAt   DateTime?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  burialSite BurialSite @relation(fields: [burialSiteId], references: [id], onDelete: Cascade)

  @@index([workspaceId, burialSiteId])
  @@index([burialSiteId])
}

// --- BLOCK 4: Experience & Retention ---

enum StoryLocaleStatus {
  DRAFT
  TRANSLATING
  READY
  FAILED
}

enum StoryTranslationJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model OnboardingProgress {
  id             String   @id @default(cuid())
  userId         String
  workspaceId    String
  currentStep    String   @default("welcome")
  completedSteps Json     @default("[]")
  skippedSteps   Json     @default("[]")
  isCompleted    Boolean  @default(false)
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model StoryLocale {
  id            String            @id @default(cuid())
  storyId       String
  locale        String
  sourceLocale  String            @default("ru")
  title         String?
  narrativeText String?           @db.Text
  status        StoryLocaleStatus @default(DRAFT)
  translatedAt  DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  story FamilyStory           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  jobs  StoryTranslationJob[]

  @@unique([storyId, locale])
  @@index([storyId])
}

model StoryTranslationJob {
  id            String                    @id @default(cuid())
  storyId       String
  storyLocaleId String?
  targetLocale  String
  status        StoryTranslationJobStatus @default(QUEUED)
  error         String?                   @db.Text
  requestedById String
  completedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  story       FamilyStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyLocale StoryLocale? @relation(fields: [storyLocaleId], references: [id], onDelete: SetNull)
  requestedBy User         @relation("StoryTranslationRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([storyId, status])
}

model QuestLeaderboardOptIn {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  optedIn     Boolean  @default(false)
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, optedIn])
}

enum MilitaryConflictStatus {
  PENDING
  APPROVED
  REJECTED
}

model MilitaryConflictDefinition {
  id           String                   @id @default(cuid())
  workspaceId  String
  name         String                   @db.VarChar(120)
  color        String?                  @db.VarChar(7)
  status       MilitaryConflictStatus   @default(PENDING)
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("MilitaryConflictCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("MilitaryConflictReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId])
}
