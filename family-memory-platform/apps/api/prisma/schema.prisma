// Family Memory Platform — PostgreSQL schema (MVP entities)
// Run: pnpm db:generate && pnpm db:migrate

generator client {
  provider      = "prisma-client-js"
  // WSL: native = debian. Windows: native = windows. Do not add explicit "windows" here — generate from WSL would try to rewrite .dll on /mnt/d/ and hit EPERM.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth & admin ---

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  auditLogs AuditLog[]
  questProgress      QuestProgress[]
  userAchievements   UserAchievement[]
  gamificationEvents GamificationEvent[]
  photoFaceTagsCreated PhotoFaceTag[] @relation("PhotoFaceTagCreator")
  mediaComments        MediaComment[]

  @@index([role])
  @@index([deletedAt])
}

enum UserRole {
  VIEWER
  EDITOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  PARTNER
  ADOPTIVE_PARENT
  ADOPTIVE_CHILD
  UNKNOWN
}

enum EventType {
  BIRTH
  DEATH
  MARRIAGE
  DIVORCE
  BURIAL
  RESIDENCE
  MIGRATION
  EDUCATION
  MILITARY
  WORK
  OCCUPATION
  IMMIGRATION
  CUSTOM
}

enum PrivacyLevel {
  PUBLIC
  FAMILY
  PRIVATE
}

enum MediaOwnerType {
  PERSON
  FAMILY
  EVENT
  DOCUMENT
  SOURCE
}

enum StorageProvider {
  MINIO
}

enum DocumentType {
  BIRTH_CERTIFICATE
  DEATH_CERTIFICATE
  MARRIAGE_CERTIFICATE
  PHOTO
  ARCHIVE_RECORD
  PASSPORT
  MILITARY_RECORD
  OTHER
}

// --- Genealogy core ---

model Person {
  id           String       @id @default(cuid())
  givenName    String
  patronymic   String?
  familyName   String?
  gender       Gender?      @default(UNKNOWN)
  birthDate    DateTime?
  deathDate    DateTime?
  isLiving     Boolean      @default(true)
  privacyLevel PrivacyLevel @default(FAMILY)
  biography    String?      @db.Text
  avatarMediaId String?     @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  avatarMedia       Media?  @relation("PersonAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  relationshipsFrom Relationship[] @relation("fromPerson")
  relationshipsTo   Relationship[] @relation("toPerson")
  familyMembers     FamilyMember[]
  events            Event[]
  media             Media[]
  documents         Document[]
  timelineItems     TimelineItem[]
  citations         Citation[]
  photoFaceTags     PhotoFaceTag[]

  @@index([familyName, givenName])
  @@index([birthDate])
  @@index([deathDate])
  @@index([isLiving])
  @@index([privacyLevel])
  @@index([deletedAt])
}

model Family {
  id        String    @id @default(cuid())
  name      String?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members FamilyMember[]
  events  Event[]

  @@index([name])
  @@index([deletedAt])
}

model FamilyMember {
  id        String           @id @default(cuid())
  familyId  String
  personId  String
  role      FamilyMemberRole @default(CHILD)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([familyId, personId])
  @@index([personId, role])
  @@index([deletedAt])
}

enum FamilyMemberRole {
  HUSBAND
  WIFE
  PARTNER
  CHILD
}

model Relationship {
  id           String           @id @default(cuid())
  fromPersonId String
  toPersonId   String
  type         RelationshipType @default(PARENT)
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  confidence   Float?           @default(1.0)
  sourceId     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  fromPerson Person  @relation("fromPerson", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson   Person  @relation("toPerson", fields: [toPersonId], references: [id], onDelete: Cascade)
  source     Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([fromPersonId])
  @@index([toPersonId])
  @@index([type])
  @@index([sourceId])
  @@index([deletedAt])
}

model Event {
  id          String    @id @default(cuid())
  type        EventType @default(CUSTOM)
  date        DateTime?
  dateEnd     DateTime?
  description String?   @db.Text
  personId    String?
  familyId    String?
  placeId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  place  Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  timelineItems TimelineItem[]

  @@index([personId, date])
  @@index([familyId, date])
  @@index([placeId])
  @@index([type])
  @@index([deletedAt])
}

model Place {
  id        String    @id @default(cuid())
  name      String
  latitude  Float?
  longitude Float?
  country   String?
  region    String?
  city      String?
  geoCountryId String?
  geoRegionId  String?
  geoCityId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  geoCountry Country? @relation(fields: [geoCountryId], references: [id], onDelete: SetNull)
  geoRegion  Region?  @relation(fields: [geoRegionId], references: [id], onDelete: SetNull)
  geoCity    City?    @relation(fields: [geoCityId], references: [id], onDelete: SetNull)
  events     Event[]

  @@index([country, region, city])
  @@index([geoCountryId])
  @@index([geoRegionId])
  @@index([geoCityId])
  @@index([name])
  @@index([deletedAt])
}

// --- Historical geography (local reference data) ---

model Country {
  id             String   @id @default(cuid())
  name           String
  historicalName String?
  iso2           String?
  iso3           String?
  periodFrom     Int?
  periodTo       Int?
  latitude       Float?
  longitude      Float?
  geonamesId     Int?     @unique
  wikidataId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  regions Region[]
  cities  City[]
  places  Place[]

  @@index([periodFrom, periodTo])
  @@index([iso2])
  @@index([name])
}

model Region {
  id         String   @id @default(cuid())
  countryId  String
  name       String
  admin1Key  String?
  periodFrom Int?
  periodTo   Int?
  geonamesId Int?     @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  City[]
  places  Place[]

  @@index([countryId])
  @@index([periodFrom, periodTo])
  @@index([name])
  @@index([admin1Key])
}

model City {
  id             String   @id @default(cuid())
  countryId      String
  regionId       String?
  name           String
  historicalName String?
  latitude       Float?
  longitude      Float?
  population     Int?
  timezone       String?
  periodFrom     Int?
  periodTo       Int?
  geonamesId     Int?     @unique
  wikidataId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  country Country              @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region  Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  aliases HistoricalPlaceAlias[]
  places  Place[]

  @@index([countryId])
  @@index([regionId])
  @@index([periodFrom, periodTo])
  @@index([name])
}

model HistoricalPlaceAlias {
  id       String   @id @default(cuid())
  cityId   String
  oldName  String
  fromYear Int?
  toYear   Int?
  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([oldName])
}

/// Localized display names (GeoNames alternateNamesV2: en, de, fr, es, ru).
enum GeoEntityType {
  COUNTRY
  REGION
  CITY
}

model GeographicName {
  id          String        @id @default(cuid())
  entityType  GeoEntityType
  entityId    String
  locale      String
  name        String
  isPreferred Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([entityType, entityId])
  @@index([locale, name])
  @@index([entityType, locale, name])
}

// --- Media & documents ---

model Media {
  id              String          @id @default(cuid())
  personId        String?
  title           String?
  mimeType        String
  storageProvider StorageProvider @default(MINIO)
  storageKey      String // MinIO object key
  bucket          String
  sizeBytes       Int?
  takenAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  person        Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  personAvatar  Person?     @relation("PersonAvatar")
  documents     Document[]
  links         MediaLink[]
  faceTags      PhotoFaceTag[]
  insight       PhotoInsight?
  comments      MediaComment[]
  analysisJobs  PhotoAnalysisJob[]

  @@unique([bucket, storageKey])
  @@index([personId])
  @@index([mimeType])
  @@index([takenAt])
  @@index([deletedAt])
}

model MediaLink {
  id        String         @id @default(cuid())
  mediaId   String
  ownerType MediaOwnerType
  ownerId   String
  createdAt DateTime       @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, ownerType, ownerId])
  @@index([ownerType, ownerId])
  @@index([mediaId])
}

enum FaceTagSource {
  MANUAL
  AI
}

enum PhotoAnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model PhotoFaceTag {
  id         String        @id @default(cuid())
  mediaId    String
  personId   String?
  x          Float
  y          Float
  width      Float
  height     Float
  confidence Float?
  label      String?
  note       String?       @db.Text
  source     FaceTagSource @default(MANUAL)
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  creator User?   @relation("PhotoFaceTagCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([personId])
  @@index([createdBy])
}

model PhotoInsight {
  id                    String   @id @default(cuid())
  mediaId               String   @unique
  estimatedYearFrom     Int?
  estimatedYearTo       Int?
  detectedObjects       Json?
  detectedClothingStyle String?
  aiDescription         String?  @db.Text
  uncertaintyNotes      String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([estimatedYearFrom, estimatedYearTo])
}

model MediaComment {
  id        String   @id @default(cuid())
  mediaId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media  Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([authorId])
}

model PhotoAnalysisJob {
  id          String              @id @default(cuid())
  mediaId     String
  status      PhotoAnalysisStatus @default(QUEUED)
  error       String?             @db.Text
  requestedBy String?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([status])
}

model Document {
  id           String       @id @default(cuid())
  personId     String?
  mediaId      String?
  sourceId     String?
  title        String
  documentType DocumentType @default(OTHER)
  mimeType     String
  storageKey   String
  bucket       String
  description  String?      @db.Text
  ocrText      String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  media  Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([mediaId])
  @@index([sourceId])
  @@index([documentType])
  @@index([deletedAt])
}

// --- Sources & citations (genealogical proof standard) ---

model Source {
  id          String    @id @default(cuid())
  title       String
  author      String?
  publication String?
  repository  String?
  url         String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  citations     Citation[]
  documents     Document[]
  relationships Relationship[]

  @@index([title])
  @@index([deletedAt])
}

model Citation {
  id        String    @id @default(cuid())
  sourceId  String
  personId  String?
  page      String?
  detail    String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  source Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([personId])
  @@index([deletedAt])
}

// --- Timeline & audit ---

model TimelineItem {
  id          String    @id @default(cuid())
  personId    String
  eventId     String?
  title       String
  description String?   @db.Text
  sortDate    DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([personId, sortDate])
  @@index([eventId])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// --- Gamification / Family Quest ---

enum QuestStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

model QuestProgress {
  id          String      @id @default(cuid())
  userId      String
  questId     String
  progress    Int         @default(0)
  target      Int
  status      QuestStatus @default(AVAILABLE)
  weekStart   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, weekStart])
  @@index([userId])
  @@index([questId])
  @@index([status])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model GamificationEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ResearchScoreSnapshot {
  id         String   @id @default(cuid())
  score      Int
  breakdown  Json
  treeRootId String?
  computedAt DateTime @default(now())

  @@index([computedAt])
}
