model WikiRevision {
  id           String   @id @default(cuid())
  wikiPageId   String
  version      Int
  content      String   @db.Text
  authorUserId String?
  createdAt    DateTime @default(now())

  wikiPage WikiPage @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)
  author   User?    @relation("WikiRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([wikiPageId, version])
  @@index([wikiPageId])
}

model WikiLink {
  id           String  @id @default(cuid())
  workspaceId  String
  fromPageId   String
  toPageId     String?
  toEntityType String?
  toEntityId   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromPage  WikiPage  @relation("WikiLinkFrom", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage    WikiPage? @relation("WikiLinkTo", fields: [toPageId], references: [id], onDelete: SetNull)

  @@index([fromPageId])
  @@index([toEntityType, toEntityId])
}

// --- BLOCK 3: Media & AI Memory Engine ---

enum FaceClusterStatus {
  UNREVIEWED
  CONFIRMED
  ASSIGNED
  MERGED
  ARCHIVED
}

enum FaceEmbeddingStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum MemoryStoryStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MediaTranscriptStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum SocialArchiveProvider {
  INSTAGRAM
  FACEBOOK
  TWITTER
  VK
  ODNOKLASSNIKI
  TELEGRAM
  UNKNOWN
}

enum SocialArchiveImportStatus {
  UPLOADED
  PARSING
  PREVIEW_READY
  PARSE_FAILED
  CONFIRMING
