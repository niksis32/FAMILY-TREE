{
  "name": "family-memory-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI Family Memory Platform — self-hosted genealogy, media archive, timeline",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @family/api dev",
    "dev:web": "pnpm --filter @family/web dev",
    "api:build": "pnpm api:prisma && pnpm --filter @family/shared build && pnpm --filter @family/genealogy-core build && pnpm --filter @family/api build",
    "api:prisma": "node scripts/prisma-generate-wsl.mjs",
    "api:start": "pnpm --filter @family/api start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:infra": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:graph": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile graph up -d",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:migrate": "node scripts/prisma-cli.mjs migrate dev",
    "db:seed": "node scripts/prisma-cli.mjs db seed",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "geography:seed": "node scripts/geography/seed-loader.mjs",
    "seed:geo": "pnpm geography:seed",
    "geography:prepare:ru": "node scripts/geography/prepare-russian-geodata.mjs",
    "geography:import:countries": "node scripts/geography/import-countries.mjs",
    "geography:import:ru-cities": "node scripts/geography/import-geonames.mjs --country=RU",
    "geography:import:ru-cities:rebuild": "node scripts/geography/import-geonames.mjs --country=RU --min-population=1000",
    "geography:import:ru-full": "pnpm geography:seed && pnpm geography:import:countries && pnpm geography:import:ru-cities:rebuild",
    "geography:import:local": "pnpm geography:prepare:ru && pnpm geography:import:ru-full",
    "geography:import:geonames": "node scripts/geography/import-geonames.mjs",
    "geography:import:wikidata": "node scripts/geography/import-wikidata.mjs",
    "geography:import:osm": "node scripts/geography/import-osm.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
