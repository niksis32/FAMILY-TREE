# =============================================================================
# Family Memory Platform — environment template
# Copy to .env in repo root and adjust for local / VPS deployment.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=family-memory-platform
APP_URL=http://localhost:3000
# Canonical origin for sitemap.xml, robots.txt, and Open Graph (Next.js)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Public family stories (PROMPT 10) ---
# Require admin approval before public/slug access (draft → submit → publish)
FAMILY_STORY_MODERATION_ENABLED=false
# CDN origin for covers/gallery: {MEDIA_CDN_BASE_URL}/{bucket}/{storageKey}
# MEDIA_CDN_BASE_URL=https://cdn.example.com
# Presigned TTL when CDN is not set (seconds, default 86400)
# MEDIA_PUBLIC_ASSET_TTL_SEC=86400
API_URL=http://localhost:4000
# Browser CORS (pnpm dev: web :3000 → API :4000). Comma-separated origins; defaults to APP_URL.
# CORS_ORIGINS=http://localhost:3000

# --- Historical map (TileServer GL, profile: tiles) ---
TILESERVER_PORT=8080
# NEXT_PUBLIC_TILESERVER_URL=http://localhost:8080
# NEXT_PUBLIC_TILESERVER_STYLE=/styles/basic/style.json
# NEXT_PUBLIC_MAP_TILE_SOURCE=tileserver-gl

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=family_platform
POSTGRES_USER=family_user
POSTGRES_PASSWORD=change_me_postgres
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# --- Redis (cache + BullMQ queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# --- MinIO (S3-compatible media storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=family_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET_MEDIA=family-media
MINIO_BUCKET_DOCUMENTS=family-documents
MINIO_USE_SSL=false

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change_me_meilisearch_master_key

# --- JWT / Auth (API) ---
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- MFA / WebAuthn (BLOCK 0) ---
# MFA_ENCRYPTION_SECRET=optional_separate_secret_for_totp_encryption
WEBAUTHN_RP_ID=localhost

# --- Neo4j (optional — docker profile: graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_ENABLED=false

# --- AI service (optional — docker profile: ai) ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=false
# Hybrid global tree matching (heuristic + ai-service /matching/score-pair). Requires AI_SERVICE_ENABLED=true.
MATCHING_AI_SCORING_ENABLED=false
# Auto OCR after document upload: REDIS_URL + AI_SERVICE_ENABLED=true + docker compose --profile ai
# Local LLM for storytelling (Ollama / OpenAI-compatible). Requires AI_SERVICE_ENABLED=true.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2
# LOCAL_LLM_TIMEOUT_SEC=120
# LOCAL_LLM_MAX_TOKENS=2048

# --- Community GraphQL subgraph (PROMPT 8 — federation-ready) ---
COMMUNITY_GRAPHQL_ENABLED=true
COMMUNITY_GRAPHQL_FEDERATION_ENABLED=true
# Introspection: defaults to false when NODE_ENV=production
# COMMUNITY_GRAPHQL_INTROSPECTION=false
COMMUNITY_GRAPHQL_MAX_DEPTH=6
COMMUNITY_GRAPHQL_RATE_LIMIT=30
COMMUNITY_GRAPHQL_SUBGRAPH_NAME=community
# Federation SDL (ops): GET /api/v1/community/graphql/federation/sdl

# --- Community forum anti-spam (PROMPT 8) ---
COMMUNITY_POST_COOLDOWN_SEC=30
COMMUNITY_POST_MAX_PER_HOUR=15
COMMUNITY_POST_MAX_PER_GROUP_HOUR=8
COMMUNITY_POST_MAX_PER_DAY=80
COMMUNITY_POST_DUPLICATE_WINDOW_SEC=900
COMMUNITY_POST_MAX_URLS=8
COMMUNITY_THREAD_COOLDOWN_SEC=60
COMMUNITY_THREAD_MAX_PER_HOUR=5
COMMUNITY_SPAM_HTTP_POST_LIMIT=10
COMMUNITY_SPAM_HTTP_THREAD_LIMIT=5

# --- Redis (photo analysis queue — BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Next.js (web) — browser-facing API base (must include /api/v1) ---
# Canonical local dev: Ubuntu/WSL, infra in Docker, API+Web on host (Variant A).
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Same port as API_URL / API_PORT (default 4000). See docs/DOCKER_LOCAL_WINDOWS_VARIANT_A_INFRA_HOST_APPS.md.
# If API runs on another port (e.g. host-run Windows with API_PORT=4002), change 4000 accordingly.
# Next.js-only override: copy apps/web/.env.local.example → apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Docker Compose overrides (prod) ---
# Required for docker-compose.prod.yml (no fallback passwords in prod overlay):
# POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
# MINIO_ROOT_USER, MINIO_ROOT_PASSWORD
# MEILI_MASTER_KEY, JWT_SECRET, NEO4J_PASSWORD
# NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1
# WEB_PORT=3000
# API_PORT=4000
# HTTP_PORT=80
# HTTPS_PORT=443
